{
  "name": "obsidian-cmd-runner",
  "version": "0.2.0",
  "description": "Runs a command of an Obsidian plugin without the window of Obsidian: on a server, or from a script",
  "license": "MIT",
  "author": "somebodil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somebodil/obsidian-cmd-runner.git"
  },
  "homepage": "https://github.com/somebodil/obsidian-cmd-runner#readme",
  "bugs": {
    "url": "https://github.com/somebodil/obsidian-cmd-runner/issues"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "cli",
    "headless",
    "ci",
    "github-actions",
    "automation"
  ],
  "type": "module",
  "bin": {
    "obsidian-cmd-runner": "bin/obsidian-cmd-runner.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "action.yml",
    "COMPATIBILITY.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "e2e": "node test/e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
